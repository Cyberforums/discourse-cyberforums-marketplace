{
  "$schema": "cf-design tokens draft v0.1 (round-1). 唯一来源：改 token 只改本文件，再运行 build_tokens.py 生成 tokens.css。",
  "meta": {
    "prefix": "cf",
    "note": "颜色值只允许出现在本文件与生成的 tokens.css；组件 CSS 一律 var(--cf-*)。暖中性灰与现网挂件 widget.css (--mc-ink #1a1917 / --mc-line #eeebe7) 保持同一色温。",
    "brandNote": "全站只保留一个品牌蓝 --cf-color-brand。现网 #356aea（widget --mc-mark）与 #2f6fed（硬编码）合并为 #2b58c4（#356aea 加深，确保在浅底 bg-subtle 上文字也过 AA）。",
    "statusTones": {
      "neutral": "灰：cancelled 已取消 / refunded 已退款 / draft",
      "info": "蓝：processing 处理中",
      "warning": "橙：pending 待付款 / on-hold 保留",
      "success": "绿：completed 已完成",
      "danger": "红：failed 付款失败；未知 status 回退灰 + 原文"
    }
  },
